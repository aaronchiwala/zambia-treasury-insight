+# ---------------- db backend selection ----------------
+def test_db_backend_auto_detects_postgres_url(monkeypatch):
+    """ZTI_DB=postgres://... switches db.py to the Postgres backend (no psycopg2 needed
+    for detection, only for actual connections)."""
+    from app import db as _db
+    monkeypatch.setattr(_db, "DB_PATH", "postgres://user:pw@host:5432/dbname")
+    assert _db._backend() == "postgres"
+    monkeypatch.setattr(_db, "DB_PATH", "postgresql://user:pw@host:5432/dbname")
+    assert _db._backend() == "postgres"
+    monkeypatch.setattr(_db, "DB_PATH", "/tmp/x.sqlite")
+    assert _db._backend() == "sqlite"
+    # Restore the test DB path so other tests in this session aren't affected
+    monkeypatch.setattr(_db, "DB_PATH", _db.DB_PATH)
+
+
