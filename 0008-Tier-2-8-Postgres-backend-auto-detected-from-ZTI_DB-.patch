+# Postgres equivalent schema (no AUTOINCREMENT; SERIAL instead).
+PG_SCHEMA = """
+CREATE TABLE IF NOT EXISTS series_meta(
+  series_id TEXT PRIMARY KEY, name TEXT, unit TEXT, frequency TEXT,
+  source TEXT, is_demo INTEGER NOT NULL DEFAULT 0, notes TEXT, last_fetched TEXT
+);
+CREATE TABLE IF NOT EXISTS observations(
+  series_id TEXT NOT NULL, date TEXT NOT NULL, value DOUBLE PRECISION NOT NULL,
+  PRIMARY KEY(series_id, date)
+);
+CREATE TABLE IF NOT EXISTS events(
+  id SERIAL PRIMARY KEY, date TEXT NOT NULL, title TEXT NOT NULL,
+  category TEXT, description TEXT, source TEXT, verified INTEGER DEFAULT 0,
+  is_demo INTEGER NOT NULL DEFAULT 0
+);
+CREATE TABLE IF NOT EXISTS ingest_log(
+  id SERIAL PRIMARY KEY, series_id TEXT, run_at TEXT,
+  rows INTEGER, status TEXT, message TEXT
+);
+CREATE TABLE IF NOT EXISTS audit_log(
+  id SERIAL PRIMARY KEY,
+  at TEXT NOT NULL,
+  action TEXT NOT NULL,
+  method TEXT,
+  path TEXT,
+  user TEXT,
+  source_ip TEXT,
+  params TEXT,
+  status_code INTEGER,
+  detail TEXT
+);
+"""
+
+
+def _backend() -> str:
+    """Return 'postgres' if ZTI_DB points at a Postgres URL, else 'sqlite'."""
+    s = str(DB_PATH)
+    if s.startswith(("postgres://", "postgresql://", "postgres+", "postgresql+")):
+        return "postgres"
+    return "sqlite"
+
+
+BACKEND = _backend()
+IS_POSTGRES = BACKEND == "postgres"
+
+
+# --- Postgres connection helpers (lazy import so sqlite-only installs don't need psycopg2) ---
+def _pg_connect():
+    try:
+        import psycopg2       # noqa: PLC0415
+    except ImportError as e:
+        raise RuntimeError(
+            "ZTI_DB points at Postgres but psycopg2 is not installed. "
+            "Add 'psycopg2-binary>=2.9' to requirements.txt and redeploy."
+        ) from e
+    parts = urlparse(str(DB_PATH))
+    return psycopg2.connect(
+        host=parts.hostname,
+        port=parts.port or 5432,
+        user=parts.username,
+        password=parts.password,
+        database=parts.path.lstrip("/"),
+    )
+
 
