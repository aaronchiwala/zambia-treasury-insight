index 7cc4645..d9f5475 100644
--- a/app/db.py
+++ b/app/db.py
@@ -27,6 +27,18 @@ CREATE TABLE IF NOT EXISTS ingest_log(
   id INTEGER PRIMARY KEY AUTOINCREMENT, series_id TEXT, run_at TEXT,
   rows INTEGER, status TEXT, message TEXT
 );
+CREATE TABLE IF NOT EXISTS audit_log(
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  at TEXT NOT NULL,
+  action TEXT NOT NULL,
+  method TEXT,
+  path TEXT,
+  user TEXT,
+  source_ip TEXT,
+  params TEXT,
+  status_code INTEGER,
+  detail TEXT
+);
 """
 
 
@@ -132,6 +144,30 @@ def recent_ingest_log(limit: int = 30) -> list[dict]:
         return [dict(r) for r in con.execute("SELECT * FROM ingest_log ORDER BY id DESC LIMIT ?", (limit,))]
 
 
+def audit(action: str, *, method: str = "", path: str = "", user: str | None = None,
+          source_ip: str | None = None, params: str = "", status_code: int | None = None,
+          detail: str = "") -> None:
+    """Append a row to the audit log. Safe to call from any request handler.
+
+    The audit_log table records every state-changing API call (refresh, demo, upload,
+    scenario post, etc.) so an operator can answer 'who changed what, when?'.
+    """
+    with connect() as con:
+        con.execute(
+            "INSERT INTO audit_log(at, action, method, path, user, source_ip, params, status_code, detail) "
+            "VALUES (?,?,?,?,?,?,?,?,?)",
+            (_now(), action[:80], method[:10], path[:240], (user or "")[:60],
+             (source_ip or "")[:60], params[:500], status_code, detail[:500]),
+        )
+
+
+def recent_audit_log(limit: int = 100) -> list[dict]:
+    with connect() as con:
+        return [dict(r) for r in con.execute(
+            "SELECT id, at, action, method, path, user, source_ip, params, status_code, detail "
+            "FROM audit_log ORDER BY id DESC LIMIT ?", (limit,))]
+
+
 def latest_problems(limit: int = 80) -> list[dict]:
     """Most recent log entry per series/source, kept only if it is an error or a warning."""
     seen, out = set(), []
