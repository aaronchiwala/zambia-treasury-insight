+def test_audit_log_records_state_changes():
+    # A scenario POST should land in the audit log with action, status_code and source_ip.
+    # Runs against the demo DB (loaded by the session fixture); audit writes do not pollute market data.
+    from app import db as _db
+    body = {"shocks": {"COPPER": -10.0}, "horizon": 4, "window": 156, "freq": "W-FRI"}
+    r = client.post("/api/scenario", json=body)
+    assert r.status_code == 200
+    log = _db.recent_audit_log(limit=10)
+    assert any(e["action"] == "scenario" and e["status_code"] == 200 for e in log), log
+    # The /api/audit endpoint exposes the same log publicly
+    r2 = client.get("/api/audit")
+    assert r2.status_code == 200
+    assert any(e["action"] == "scenario" for e in r2.json()["events"])
+
