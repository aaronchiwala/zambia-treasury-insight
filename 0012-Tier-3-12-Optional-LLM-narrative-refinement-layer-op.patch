+"""Optional LLM narrative refinement layer.
+
+Takes the rule-based narrative bullets produced by attribution._narrative() and
+asks a hosted LLM (via the z-ai-web-dev-sdk) to produce a polished 1-2 paragraph
+summary. Strictly opt-in: only runs when ZTI_LLM_ENABLED=1 is set in the env.
+
+Guardrails (these are non-negotiable):
+  * The LLM is given the EXISTING narrative bullets and the event list. It must
+    NOT invent numbers, dates, or events.
+  * The system prompt explicitly forbids causal language ('caused', 'drove',
+    'led to'). The output must use associative language ('coincided with',
+    'was associated with') exactly like the rule-based narrative.
+  * If the LLM call fails for any reason (network, timeout, malformed response),
+    the endpoint returns the original rule-based bullets unchanged.
+  * The refined narrative is marked with `refined_by_llm: true` so the UI can
+    badge it; the original bullets are always returned alongside for transparency.
+  * The LLM never sees user credentials, the password, or any PII — only the
+    public market narrative and event titles already returned by /api/explain.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+
+SYSTEM_PROMPT = """You are a financial-market editor. Your job is to take a list of rule-based
+narrative bullets about a currency move and rewrite them as a single fluent
+paragraph (no more than 2 paragraphs, ~120 words total) suitable for a
+treasury dashboard.
+
+STRICT RULES — VIOLATION MAKES THE OUTPUT UNUSABLE:
+
+1. Use ONLY the facts in the input bullets. Do NOT invent numbers, dates,
+   events, driver names, or attribution percentages. If the bullets say
+   'copper moved -3.2%', your output must say 'copper moved -3.2%' — never
+   'copper fell about 3%' or 'copper dropped to a lower level'.
+2. NEVER use causal language. The analysis identifies statistical association,
+   not causation. Forbidden words: 'caused', 'drove', 'led to', 'triggered',
+   'sparked', 'forced', 'made', 'resulted in'. Required phrasing:
+   'coincided with', 'was associated with', 'tracked', 'moved alongside'.
+3. Preserve the direction conventions: USD/ZMW up = weaker kwacha.
+4. Do NOT mention the model, R², or methodology — the reader sees those
+   elsewhere. Focus on what moved and what it was associated with.
+5. If the bullets mention events that coincided, name them with their dates.
+6. Output ONLY the rewritten paragraph(s). No preamble, no labels, no
+   markdown headers, no bullet points."""
+
+
+def llm_enabled() -> bool:
+    """True only if ZTI_LLM_ENABLED=1 is explicitly set in the env."""
+    return os.environ.get("ZTI_LLM_ENABLED") == "1"
+
+
+def refine_narrative(bullets: list[str], events: list[dict] | None = None) -> tuple[str, str]:
+    """Refine rule-based bullets into a fluent paragraph.
+
+    Returns (refined_text, status). Status is one of:
+      'ok'        — LLM produced output
+      'disabled'  — ZTI_LLM_ENABLED not set; returned the joined bullets
+      'error'     — LLM call failed; returned the joined bullets
+
+    The caller should ALWAYS fall back to the original bullets on 'disabled'
+    or 'error'. The refined text is supplementary polish, never the only
+    narrative.
+    """
+    if not llm_enabled():
+        return "\n".join(bullets), "disabled"
+
+    # Build the user prompt: the bullets + a compact event list
+    event_lines = []
+    for e in (events or [])[:8]:
+        event_lines.append(f"  - {e.get('date', '')} {e.get('title', '')}")
+    event_block = "\n".join(event_lines) if event_lines else "  (none)"
+    user_prompt = (
+        "Rewrite the following rule-based narrative bullets into a single fluent "
+        "paragraph (max 2 paragraphs, ~120 words). Use ONLY the facts below.\n\n"
+        "Bullets:\n" + "\n".join(f"  - {b}" for b in bullets)
+        + "\n\nEvents that coincided with the window:\n" + event_block
+        + "\n\nOutput ONLY the rewritten paragraph(s)."
+    )
+
+    try:
+        refined = _call_llm(SYSTEM_PROMPT, user_prompt)
+        if not refined or len(refined) < 20:
+            return "\n".join(bullets), "error"
+        # Light sanity check: if the LLM ignored the rules and produced
+        # causal language, fall back. (The system prompt forbids it; this
+        # is a defensive check.)
+        banned = [" caused ", " drove ", " led to ", " triggered ", " sparked ",
+                  " forced ", " made the ", " resulted in "]
+        for w in banned:
+            if w in refined.lower():
+                return "\n".join(bullets), "error"
+        return refined.strip(), "ok"
+    except Exception:
+        return "\n".join(bullets), "error"
+
+
+def _call_llm(system: str, user: str) -> str:
+    """Invoke the z-ai CLI chat command and return the content string.
+
+    Uses subprocess + a temp file for the JSON output (the CLI doesn't
+    print clean JSON to stdout due to its progress banners).
+    """
+    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as tf:
+        out_path = tf.name
+    try:
+        cmd = ["z-ai", "chat", "-p", user, "-s", system, "-o", out_path]
+        # Timeout: 15 seconds. If the LLM is slow, fall back to the bullets.
+        subprocess.run(cmd, check=True, capture_output=True, timeout=15, text=True)
+        with open(out_path) as fh:
+            data = json.load(fh)
+        return data["choices"][0]["message"]["content"]
+    finally:
+        try:
+            Path(out_path).unlink()
+        except OSError:
+            pass
