+# ---------------- LLM narrative refinement (optional) ----------------
+def test_llm_narrative_is_disabled_by_default(monkeypatch):
+    """Without ZTI_LLM_ENABLED=1, the refinement returns the joined bullets unchanged."""
+    monkeypatch.delenv("ZTI_LLM_ENABLED", raising=False)
+    from app.analytics import narrative_llm
+    assert narrative_llm.llm_enabled() is False
+    bullets = ["First bullet.", "Second bullet with a number 12.3%."]
+    refined, status = narrative_llm.refine_narrative(bullets)
+    assert status == "disabled"
+    assert refined == "First bullet.\nSecond bullet with a number 12.3%."
+
+
+def test_llm_narrative_falls_back_on_causal_language(monkeypatch):
+    """If the (mocked) LLM output contains causal language, the helper falls back to the bullets."""
+    monkeypatch.setenv("ZTI_LLM_ENABLED", "1")
+    from app.analytics import narrative_llm
+    # Patch the internal LLM caller to return a bad output that uses 'caused'
+    monkeypatch.setattr(narrative_llm, "_call_llm",
+                        lambda sys, user: "The copper crash caused the kwacha to weaken.")
+    bullets = ["Copper fell 10%; the kwacha tracked it lower."]
+    refined, status = narrative_llm.refine_narrative(bullets)
+    assert status == "error"
+    assert refined == bullets[0]   # fell back to the joined bullets
+
+
+def test_llm_narrative_returns_refined_text_when_output_is_clean(monkeypatch):
+    """When the (mocked) LLM returns clean associative language, the helper returns it."""
+    monkeypatch.setenv("ZTI_LLM_ENABLED", "1")
+    from app.analytics import narrative_llm
+    clean = ("Between June and December 2021 the kwacha weakened by 8.2%. "
+             "This coincided with a 12% drop in copper prices, which was associated "
+             "with about 4pp of the move. The 2021-08-12 general election also "
+             "tracked the depreciation.")
+    monkeypatch.setattr(narrative_llm, "_call_llm", lambda sys, user: clean)
+    bullets = ["Original bullet 1.", "Original bullet 2."]
+    refined, status = narrative_llm.refine_narrative(bullets)
+    assert status == "ok"
+    assert refined == clean
+
+
