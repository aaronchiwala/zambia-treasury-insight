+def read_long(path, *, skip_tenors: set[str] | None = None) -> dict[str, tuple[pd.Series, str]]:
+    """Long-format reader: <path>.csv with columns date,tenor,value.
+
+    Returns a dict mapping each tenor code (which must be a registered series_id)
+    to (series, source). Tenor codes not in SERIES are silently skipped.
+
+    `skip_tenors` lets the caller exclude tenors that have their own dedicated
+    wide-format file. The BoZ yields sheet, for example, also reports the policy
+    rate alongside T-bill/bond yields — but the authoritative policy rate lives
+    in data/manual/POLICY_RATE.csv (with exact rate-change dates from MPC
+    statements), so the long-format policy_rate column should NOT override it.
+    """
+    skip = skip_tenors or set()
+    text = path.read_text(encoding="utf-8")
+    source, body = _strip_comments(text)
+    df = pd.read_csv(io.StringIO(body))
+    df.columns = [c.strip().lower() for c in df.columns]
+    if not {"date", "tenor", "value"}.issubset(df.columns):
+        return {}
+    df["date"] = pd.to_datetime(df["date"])
+    df["value"] = pd.to_numeric(df["value"], errors="coerce")
+    df = df.dropna(subset=["date", "value"])
+    out: dict[str, tuple[pd.Series, str]] = {}
+    for tenor, sub in df.groupby("tenor"):
+        tenor = str(tenor).strip()
+        if tenor not in SERIES or tenor in skip:
+            continue
+        s = sub.set_index("date")["value"].sort_index().astype(float)
+        s = s[~s.index.duplicated(keep="last")]
+        out[tenor] = (s, source)
+    return out
+
+
+# Files whose stem is exactly a SERIES_ID -> wide format.
+# Files whose stem starts with TBILL_BOND_ -> long format (multi-tenor auction yields).
+LONG_FORMAT_PREFIXES = ("TBILL_BOND_",)
+
+
+def _is_long_format(path: Path) -> bool:
+    stem = path.stem.upper()
+    return any(stem.startswith(p) for p in LONG_FORMAT_PREFIXES)
+
+
