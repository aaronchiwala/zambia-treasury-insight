+/**
+ * Typed API client for the Zambia Treasury Insight FastAPI backend.
+ *
+ * The base URL is read from NEXT_PUBLIC_API_URL (set at build time) and defaults
+ * to the live Render deployment so local dev works out of the box.
+ *
+ * If /api/security reports auth_enabled=true, Basic Auth credentials are read
+ * from localStorage and attached to every request.
+ */
+
+const API_BASE =
+  process.env.NEXT_PUBLIC_API_URL || 'https://zambia-treasury-insight.onrender.com';
+
+// ---------- Types ----------
+export type DataMode = 'demo' | 'mixed' | 'live' | 'empty';
+
+export interface SeriesMeta {
+  series_id: string;
+  name: string;
+  unit: string;
+  native: string;
+  source: string;
+  is_demo: boolean;
+  n_obs: number;
+  first_date: string | null;
+  last_date: string | null;
+  age_days: number | null;
+  stale: boolean;
+  last_fetched: string;
+}
+
+export interface StatusResponse {
+  mode: DataMode;
+  series: SeriesMeta[];
+  notes: string[];
+  refresh: {
+    running?: boolean;
+    last_run?: string;
+    last_error?: string | null;
+    last_failed?: string[];
+  };
+  problems: Array<Record<string, unknown>>;
+  registry: Array<{ series_id: string; name: string; unit: string; native: string }>;
+  controls_locked: boolean;
+  ingest_log: Array<Record<string, unknown>>;
+  server_time: string;
+}
+
+export interface OverviewCard {
+  series_id: string;
+  name: string;
+  unit: string;
+  kind: 'price' | 'rate';
+  last: number;
+  date: string;
+  chg_1w: number | null;
+  chg_4w: number | null;
+  chg_12w: number | null;
+  chg_52w: number | null;
+  is_demo: boolean;
+}
+
+export interface OverviewResponse {
+  cards: OverviewCard[];
+  mode: DataMode;
+}
+
+export interface SeriesData {
+  dates: string[];
+  values: number[];
+  name: string;
+  unit: string;
+}
+
+export interface RegimeEvent {
+  date: string;
+  title: string;
+  category: string;
+  description: string;
+  source: string;
+  verified: boolean;
+  is_demo: boolean;
+  regime: string | null;
+  regime_label: string | null;
+}
+
+export interface Regime {
+  start: string;
+  end: string | null;
+  key: string;
+  label: string;
+  narrative: string;
+}
+
+export interface SecurityPosture {
+  auth_enabled: boolean;
+  username: string | null;
+  hosted_on_render: boolean;
+  controls_locked: boolean;
+  advice: string;
+}
+
+export interface ModelDoc {
+  spec: {
+    target: string;
+    frequency: string;
+    unit: string;
+    sample_start: string;
+    sample_end: string;
+    n: number;
+    r2: number;
+    validation_date: string;
+    method: string;
+    drivers: Array<{
+      driver: string;
+      label: string;
+      beta: number;
+      se: number;
+      p_value: number;
+      series: string;
+    }>;
+    excluded: string[];
+  };
+  backtest: {
+    horizons: number[];
+    summary: Array<Record<string, number | null>>;
+    metric_definitions: Record<string, string>;
+  };
+  data_sources: Record<string, {
+    name: string;
+    source: string;
+    first_date: string | null;
+    last_date: string | null;
+    n_obs: number | null;
+  }>;
+  skipped: string[];
+  server_time: string;
+}
+
+export interface AuditEntry {
+  id: number;
+  at: string;
+  action: string;
+  method: string;
+  path: string;
+  user: string;
+  source_ip: string;
+  params: string;
+  status_code: number | null;
+  detail: string;
+}
+
+// ---------- Auth helper ----------
+function authHeader(): Record<string, string> {
+  if (typeof window === 'undefined') return {};
+  const creds = window.localStorage.getItem('zti_basic_auth');
+  if (!creds) return {};
+  return { Authorization: `Basic ${creds}` };
+}
+
+// ---------- Core fetch ----------
+async function apiGet<T>(path: string): Promise<T> {
+  const res = await fetch(`${API_BASE}${path}`, {
+    headers: { ...authHeader(), Accept: 'application/json' },
+    cache: 'no-store',
+  });
+  if (res.status === 401) {
+    throw new Error('Authentication required. Set credentials in the connection settings.');
+  }
+  if (!res.ok) {
+    const text = await res.text();
+    throw new Error(`API ${res.status}: ${text.slice(0, 200)}`);
+  }
+  return res.json();
+}
+
+async function apiPost<T>(path: string, body?: unknown): Promise<T> {
+  const res = await fetch(`${API_BASE}${path}`, {
+    method: 'POST',
+    headers: {
+      ...authHeader(),
+      'Content-Type': 'application/json',
+      Accept: 'application/json',
+    },
+    body: body ? JSON.stringify(body) : undefined,
+    cache: 'no-store',
+  });
+  if (res.status === 401) {
+    throw new Error('Authentication required.');
+  }
+  if (!res.ok) {
+    const text = await res.text();
+    throw new Error(`API ${res.status}: ${text.slice(0, 200)}`);
+  }
+  return res.json();
+}
+
+// ---------- Endpoints ----------
+export const api = {
+  health: () => apiGet<{ ok: boolean }>('/api/health'),
+  security: () => apiGet<SecurityPosture>('/api/security'),
+  status: () => apiGet<StatusResponse>('/api/status'),
+  overview: () => apiGet<OverviewResponse>('/api/overview'),
+  series: (ids: string[], start?: string, end?: string, maxPoints = 2500) =>
+    apiGet<Record<string, SeriesData>>(
+      `/api/series?ids=${ids.join(',')}${start ? `&start=${start}` : ''}${
+        end ? `&end=${end}` : ''
+      }&max_points=${maxPoints}`,
+    ),
+  events: () => apiGet<{ events: RegimeEvent[]; mode: DataMode }>('/api/events'),
+  regimes: () => apiGet<{ regimes: Regime[] }>('/api/regimes'),
+  explain: (start: string, end: string, freq = 'W-FRI', window?: number) =>
+    apiGet<unknown>(
+      `/api/explain?start=${start}&end=${end}&freq=${freq}${window ? `&window=${window}` : ''}`,
+    ),
+  history: (threshold = 8.0, freq = 'W-FRI') =>
+    apiGet<unknown>(`/api/history?threshold=${threshold}&freq=${freq}`),
+  model: (freq = 'W-FRI', window?: number) =>
+    apiGet<unknown>(`/api/model?freq=${freq}${window ? `&window=${window}` : ''}`),
+  backtest: (freq = 'W-FRI', horizons = '1,4,8,12', step = 2) =>
+    apiGet<unknown>(`/api/backtest?freq=${freq}&horizons=${horizons}&step=${step}`),
+  forecast: (h = 12, model = 'auto', freq = 'W-FRI') =>
+    apiGet<unknown>(`/api/forecast?h=${h}&model=${model}&freq=${freq}`),
+  scenarioPresets: (freq = 'W-FRI') =>
+    apiGet<unknown>(`/api/scenario/presets?freq=${freq}`),
+  scenario: (body: {
+    shocks: Record<string, number>;
+    horizon: number;
+    window: number;
+    freq: string;
+  }) => apiPost<unknown>('/api/scenario', body),
+  audit: (limit = 100) => apiGet<{ events: AuditEntry[] }>(`/api/audit?limit=${limit}`),
+  modelDocs: (freq = 'W-FRI', window?: number) =>
+    apiGet<ModelDoc>(`/api/model-docs?freq=${freq}${window ? `&window=${window}` : ''}`),
+  modelDocsPdfUrl: (freq = 'W-FRI') =>
+    `${API_BASE}/api/model-docs.pdf?freq=${freq}`,
+  refresh: () => apiPost<{ started: boolean; running: boolean }>('/api/refresh'),
+};
+
+export const API_BASE_URL = API_BASE;
+
+/** Save Basic Auth credentials to localStorage. */
+export function setAuth(user: string, password: string): void {
+  if (typeof window === 'undefined') return;
+  const creds = btoa(`${user}:${password}`);
+  window.localStorage.setItem('zti_basic_auth', creds);
+}
+
+/** Clear stored Basic Auth credentials. */
+export function clearAuth(): void {
+  if (typeof window === 'undefined') return;
+  window.localStorage.removeItem('zti_basic_auth');
+}
