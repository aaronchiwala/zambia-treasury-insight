+'use client';
+
+import { useEffect, useState } from 'react';
+import { api, type StatusResponse, type OverviewResponse } from '@/lib/api';
+
+export default function OverviewPage() {
+  const [status, setStatus] = useState<StatusResponse | null>(null);
+  const [overview, setOverview] = useState<OverviewResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    Promise.all([api.status(), api.overview()])
+      .then(([s, o]) => {
+        setStatus(s);
+        setOverview(o);
+      })
+      .catch((e) => setError(String(e)));
+  }, []);
+
+  if (error) {
+    return <div className="text-red-600">Error: {error}</div>;
+  }
+  if (!status || !overview) {
+    return <div>Loading...</div>;
+  }
+
+  return (
+    <div className="space-y-6">
+      <header>
+        <h2 className="text-2xl font-bold">Overview</h2>
+        <p className="text-sm text-slate-500">
+          Data mode: <strong>{status.mode}</strong> · Last refresh:{' '}
+          {status.refresh.last_run ?? 'never'} ·{' '}
+          <a href="/data" className="text-teal-600 underline">Data &amp; quality →</a>
+        </p>
+        {status.notes.length > 0 && (
+          <div className="mt-3 p-3 rounded bg-amber-50 border border-amber-200 text-amber-900 text-sm">
+            {status.notes.map((n, i) => (
+              <p key={i}>• {n}</p>
+            ))}
+          </div>
+        )}
+      </header>
+
+      <section className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
+        {overview.cards.map((c) => (
+          <div
+            key={c.series_id}
+            className="p-4 rounded-lg border"
+            style={{ background: 'var(--color-card)', borderColor: 'var(--color-border)' }}
+          >
+            <div className="text-xs text-slate-500 uppercase">{c.series_id}</div>
+            <div className="text-lg font-semibold mt-1">
+              {c.last.toLocaleString(undefined, { maximumFractionDigits: 2 })}{' '}
+              <span className="text-xs font-normal text-slate-500">{c.unit}</span>
+            </div>
+            <div className="text-xs text-slate-400 mt-1">{c.date}</div>
+            <div className="mt-2 text-xs space-y-0.5">
+              <div>1w: {fmtChange(c.chg_1w, c.kind)}</div>
+              <div>4w: {fmtChange(c.chg_4w, c.kind)}</div>
+              <div>12w: {fmtChange(c.chg_12w, c.kind)}</div>
+              <div>52w: {fmtChange(c.chg_52w, c.kind)}</div>
+            </div>
+          </div>
+        ))}
+      </section>
+
+      <section>
+        <h3 className="text-lg font-semibold mb-2">USD/ZMW — full history</h3>
+        <div className="p-4 rounded-lg border" style={{ background: 'var(--color-card)' }}>
+          <p className="text-sm text-slate-500">
+            The Plotly chart of USD/ZMW over time goes here. It will be rendered by
+            a <code>USZMWChart</code> component using <code>react-plotly.js</code>,
+            with regime bands and event markers overlaid. See the migration plan in{' '}
+            <code>frontend/MIGRATION.md</code> for the build order.
+          </p>
+        </div>
+      </section>
+    </div>
+  );
+}
+
+function fmtChange(v: number | null, kind: 'price' | 'rate'): string {
+  if (v === null) return '—';
+  if (kind === 'price') {
+    const sign = v >= 0 ? '+' : '';
+    return `${sign}${v.toFixed(2)}%`;
+  }
+  const sign = v >= 0 ? '+' : '';
+  return `${sign}${v.toFixed(2)} pp`;
+}
