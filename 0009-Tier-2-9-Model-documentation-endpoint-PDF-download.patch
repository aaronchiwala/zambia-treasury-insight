+def test_model_docs_endpoint_and_pdf():
+    # The JSON endpoint returns a self-contained model specification.
+    r = client.get("/api/model-docs")
+    assert r.status_code == 200
+    body = r.json()
+    assert body["spec"]["target"] == "USD/ZMW (kwacha per US dollar)"
+    assert body["spec"]["frequency"] == "W-FRI"
+    assert body["spec"]["n"] > 0
+    assert body["spec"]["r2"] >= 0.0
+    assert isinstance(body["spec"]["drivers"], list) and body["spec"]["drivers"]
+    assert body["backtest"]["summary"]
+    assert body["backtest"]["metric_definitions"]["MAE"]
+    assert body["data_sources"]
+
+    # The PDF endpoint should return a non-empty application/pdf body (reportlab is installed).
+    r2 = client.get("/api/model-docs.pdf")
+    assert r2.status_code == 200
+    assert r2.headers["content-type"] == "application/pdf"
+    assert len(r2.content) > 5000      # a real PDF is at least several KB
+    assert r2.content.startswith(b"%PDF")
+
+
