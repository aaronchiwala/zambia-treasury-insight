+def test_regimes_endpoint_and_event_tagging():
+    r = client.get("/api/regimes")
+    assert r.status_code == 200
+    regimes = r.json()["regimes"]
+    keys = [reg["key"] for reg in regimes]
+    assert "pre_redenom" in keys and "pre_default" in keys
+    assert "default_no_imf" in keys and "imf_ecf" in keys
+    # Each regime has start, end (may be null), key, label, narrative
+    for reg in regimes:
+        assert all(k in reg for k in ("start", "end", "key", "label", "narrative"))
+
+    # The /api/events response tags every event with its regime (whatever events are loaded).
+    ev = client.get("/api/events").json()
+    assert ev["events"]
+    for e in ev["events"]:
+        assert "regime" in e and "regime_label" in e, f"event missing regime tag: {e}"
+        if e.get("regime"):
+            assert e["regime"] in keys, f"unknown regime {e['regime']} on event {e['title']}"
+
+    # regime_for() returns the correct regime for known breakpoints
+    from app.config import regime_for
+    assert regime_for("2019-01-15")["key"] == "pre_default"
+    assert regime_for("2020-11-13")["key"] == "default_no_imf"
+    assert regime_for("2021-06-01")["key"] == "default_no_imf"
+    assert regime_for("2022-09-01")["key"] == "imf_ecf"
+    assert regime_for("2026-01-01")["key"] == "imf_ecf"
+    assert regime_for("2005-06-01")["key"] == "pre_redenom"
+
+
 def test_overview_and_series():
