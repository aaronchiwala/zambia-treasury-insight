 NATIVE_RANK = {"D": 1, "E": 1, "W": 2, "M": 3, "Q": 4}
 FREQ_RANK = {"W-FRI": 2, "ME": 3}
 PERIODS_PER_YEAR = {"W-FRI": 52, "ME": 12}
+
+# --- Regime markers ---
+# Zambia's USD/ZMW behaviour has shifted across distinct policy/market regimes.
+# These breakpoints are used by /api/regimes and to tag events in /api/events, and
+# the UI can draw vertical bands at these dates. They are deliberately a small,
+# defensible list — every breakpoint must have a clear narrative anchor.
+REGIMES: list[dict] = [
+    dict(
+        start="2001-01-01", end="2013-01-01",
+        key="pre_redenom",
+        label="Pre-redenomination (ZMK)",
+        narrative="Old kwacha era. The Bank of Zambia's REER sheet back-adjusts these rates to new-kwacha terms so the series is continuous across the 2013 1000:1 redenomination.",
+    ),
+    dict(
+        start="2013-01-01", end="2020-11-13",
+        key="pre_default",
+        label="Pre-Eurobond default",
+        narrative="Post-redenomination era of managed FX. BoZ intervened regularly; the kwacha traded in a 5-15 range against the dollar.",
+    ),
+    dict(
+        start="2020-11-13", end="2022-08-31",
+        key="default_no_imf",
+        label="Eurobond default, no IMF programme",
+        narrative="Zambia became the first African sovereign default of the pandemic era on 2020-11-13. The kwacha depreciated sharply; no external financing anchor.",
+    ),
+    dict(
+        start="2022-08-31", end=None,
+        key="imf_ecf",
+        label="IMF Extended Credit Facility",
+        narrative="IMF Executive Board approved an ECF arrangement on 2022-08-31 (Press Release 22/297). Six reviews completed through Jan 2026; the kwacha stabilised then strengthened through 2024-2026 as the programme anchored policy.",
+    ),
+]
+
+
+def regime_for(date) -> dict | None:
+    """Return the regime dict whose [start, end) window contains `date`, or None."""
+    import pandas as pd
+    d = pd.Timestamp(date)
+    for r in REGIMES:
+        start = pd.Timestamp(r["start"])
+        end = pd.Timestamp(r["end"]) if r["end"] else pd.Timestamp.max
+        if start <= d < end:
+            return r
+    return None
