From 37df525cfd35d221ed5d7c894582b594bd5bae78 Mon Sep 17 00:00:00 2001
From: Zambia Treasury Insight <patch@local>
Date: Tue, 24 Nov 2026 18:22:24 +0000
Subject: [PATCH 03/12] Tier 1 #3: Dockerfile + .dockerignore for local/alt
 hosting

Render uses its own Python runtime, but having a Dockerfile means:
  - devs can run the exact production image locally (docker build . && docker run -p 8000:8000)
  - the app can be hosted anywhere that runs containers (Fly.io, Railway, self-hosted)
  - CI could later build and push an image as part of the release workflow

Image is python:3.12-slim, installs requirements.txt, copies the app, exposes
8000, boots uvicorn, and health-checks /api/health (same as Render).
---
 .dockerignore | 23 +++++++++++++++++++++++
 Dockerfile    | 35 +++++++++++++++++++++++++++++++++++
 2 files changed, 58 insertions(+)
 create mode 100644 .dockerignore
 create mode 100644 Dockerfile

diff --git a/.dockerignore b/.dockerignore
new file mode 100644
index 0000000..694ff16
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,23 @@
+# Files that should not make it into the Docker image.
+.git
+.github
+.gitignore
+.pytest_cache
+__pycache__
+**/__pycache__
+**/*.pyc
+.venv
+venv
+env
+.env
+*.sqlite
+*.sqlite-wal
+*.sqlite-shm
+data/zti.sqlite*
+tests
+*.md
+!README.md
+download
+uploads
+node_modules
+.DS_Store
diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..56a910c
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,35 @@
+# Local development & alternate hosting. Render uses its own Python runtime,
+# so this Dockerfile is for running the app identically off-Render.
+
+FROM python:3.12-slim
+
+WORKDIR /app
+
+# System deps: none required (FastAPI + pandas + statsmodels are pure wheels).
+# If you add scipy/numpy source builds later, install build-essential here.
+
+# Install Python deps first (better layer caching).
+COPY requirements.txt .
+RUN pip install --no-cache-dir -r requirements.txt
+
+# Copy the app.
+COPY app/ app/
+COPY static/ static/
+COPY data/ data/
+COPY docs/ docs/
+COPY README.md render.yaml .env.example ./
+
+# Default env (overridable at runtime).
+ENV ZTI_DB=/app/data/zti.sqlite \
+    ZTI_AUTO_INGEST=1 \
+    ZTI_REFRESH_HOURS=12 \
+    PORT=8000
+
+EXPOSE 8000
+
+# Boot the API. The scheduler thread runs inside the same process.
+CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
+
+# Health check: same endpoint Render uses.
+HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=3 \
+    CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:${PORT:-8000}/api/health').status==200 else 1)"
