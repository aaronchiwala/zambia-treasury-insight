+def test_security_endpoint_reports_auth_posture():
+    # In tests ZTI_PASSWORD is unset, so auth is off and advice explains how to enable it.
+    r = client.get("/api/security")
+    assert r.status_code == 200
+    body = r.json()
+    assert body["auth_enabled"] is False
+    assert body["username"] is None
+    assert "ZTI_PASSWORD" in body["advice"]
+    # The endpoint must NOT echo any password (there isn't one set, but the field shouldn't exist)
+    assert "password" not in body
+
+
 def test_overview_and_series():
     ov = client.get("/api/overview").json()
     assert ov["cards"][0]["series_id"] == "USDZMW"
