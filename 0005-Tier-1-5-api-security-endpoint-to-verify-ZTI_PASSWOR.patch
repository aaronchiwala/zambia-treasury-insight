From: Zambia Treasury Insight <patch@local>
Date: Tue, 24 Nov 2026 18:24:44 +0000
Subject: [PATCH 05/12] Tier 1 #5: /api/security endpoint to verify
 ZTI_PASSWORD on Render

Adds a publicly-readable /api/security endpoint (alongside /api/health) that
reports:
  - auth_enabled (bool): is ZTI_PASSWORD set?
  - username: the configured ZTI_USER (default 'treasury') if auth is on
  - hosted_on_render: detects the RENDER env signal
  - controls_locked: True on a public host without a password (data controls disabled)
  - advice: human-readable next-step guidance

This is exempted from Basic Auth so an operator can verify the deployment's
security posture from their laptop without needing credentials:
  curl -s https://app.onrender.com/api/security | python -m json.tool

Never echoes the password value itself.

Updates docs/DEPLOY_RENDER.md section 5 with the verification command. Adds one
test (71 total, all passing).
---
 app/main.py                      | 25 +++++++++++++++++++++++--
 docs/DEPLOY_RENDER.md            |  7 +++++++
 tests/test_connectors_and_api.py | 12 ++++++++++++
 3 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/app/main.py b/app/main.py
index 585f08d..445b0ed 100644
--- a/app/main.py
+++ b/app/main.py
@@ -69,9 +69,10 @@ app = FastAPI(title="Zambia Treasury Insight", version="0.2.0", lifespan=lifespa
 
 @app.middleware("http")
 async def optional_basic_auth(request, call_next):
-    """If ZTI_PASSWORD is set, every route except /api/health needs HTTP Basic credentials."""
+    """If ZTI_PASSWORD is set, every route except /api/health and /api/security needs HTTP Basic credentials.
+    /api/security stays open so an operator can verify the auth posture without authenticating."""
     password = os.environ.get("ZTI_PASSWORD")
-    if not password or request.url.path == "/api/health":
+    if not password or request.url.path in ("/api/health", "/api/security"):
         return await call_next(request)
     user = os.environ.get("ZTI_USER", "treasury")
     ok = False
@@ -157,6 +158,26 @@ def health():
     return dict(ok=True)
 
 
+@app.get("/api/security")
+def security():
+    """Publicly inspectable security posture. Helps verify ZTI_PASSWORD is actually set on Render.
+
+    Returns whether auth is enabled, whether data controls are locked, and the configured username
+    (if any). Never echoes the password itself.
+    """
+    password_set = bool(os.environ.get("ZTI_PASSWORD"))
+    user = os.environ.get("ZTI_USER", "treasury") if password_set else None
+    return dict(
+        auth_enabled=password_set,
+        username=user,
+        hosted_on_render=bool(os.environ.get("RENDER")),
+        controls_locked=_hosted_unprotected(),
+        advice=("All endpoints (except /api/health) require HTTP Basic Auth."
+                if password_set else
+                "Auth is OFF. On a public host, set ZTI_PASSWORD in the Render dashboard "
+                "(Environment tab) and redeploy. Data controls are locked until you do."))
+
+
 def _hosted_unprotected() -> bool:
     """On a public host (Render sets RENDER) without a password, nobody may change data from the browser."""
     return bool(os.environ.get("RENDER")) and not os.environ.get("ZTI_PASSWORD")
